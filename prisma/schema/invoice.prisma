// prisma/schema/invoice.prisma

model Invoice {
  id              String              @id @default(cuid())
  sellerWallet    String
  amount          Decimal             @default(0)
  currency        String              @default("USDC")
  status          String              @default("PENDING")
  statusUpdatedAt DateTime            @default(now())
  rate            Decimal?
  maturityDate    DateTime?
  riskRating      String?
  fundingProgress Decimal?            @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  watchlists      InvestorWatchlist[]
  secondaryTrades InvoiceSecondaryTradePrice[]

  @@index([sellerWallet])
  @@index([status])
}

model InvoiceSecondaryTradePrice {
  id        String   @id @default(cuid())
  invoiceId String
  price     Decimal
  amount    Decimal
  tradedAt  DateTime @default(now())
  txHash    String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, tradedAt(sort: Desc)])
  @@map("invoice_secondary_trade_prices")
}
