// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

model OutboxEvent {
  id            String   @id @default(cuid())
  type         String
  payload      Json
  createdAt    DateTime @default(now())
  publishedAt  DateTime?
  attempts     Int      @default(0)
  // Dispatch priority: "critical" | "normal" | "bulk" (#1341). Critical events
  // are always fetched first; bulk events are capped per poll cycle.
  priority     String   @default("normal")

  @@index([type])
  @@index([publishedAt])
  @@index([createdAt])
}

model WalletReputation {
  address       String   @id
  score         Int      @default(0)
  flags         String   @default("") // Comma-separated flag names
  updatedAt     DateTime @updatedAt

  @@index([score(sort: Desc)])
  @@index([flags])
}

generator client {
  provider        = "prisma-client-js"
  output          = "../../node_modules/.prisma/client"
  previewFeatures = ["prismaSchemaFolder", "metrics"]
}

datasource db {
  provider          = "postgres"
   url      = env("DATABASE_URL") // You can safely ignore the error on this line.
}