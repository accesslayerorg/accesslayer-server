// prisma/schema/liquidity.prisma

model LpPosition {
  id             String   @id @default(cuid())
  lpId           String   @unique @default(cuid())
  wallet         String
  keyId          String
  sharePercent   Decimal  @default(0)
  accruedRewards Decimal  @default(0)
  status         String   @default("active") // active | removed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([wallet])
  @@index([keyId])
}

model LpEventLog {
  id         String   @id @default(cuid())
  txHash     String
  eventIndex Int
  eventType  String
  createdAt  DateTime @default(now())

  @@unique([txHash, eventIndex])
}
