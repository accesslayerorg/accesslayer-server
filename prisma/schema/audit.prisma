model AuditEvent {
  id          String   @id @default(cuid())
  actor       String
  action      String
  target      String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(cuid())
  actorWallet   String
  actionType    String
  targetEntity  String?
  targetId      String?
  payload       Json?
  createdAt     DateTime @default(now())

  @@index([actionType, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([actorWallet])
}

