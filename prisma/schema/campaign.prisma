// prisma/schema/campaign.prisma

model Campaign {
  id              String                     @id @default(cuid())
  name            String
  description     String?
  status          String                     @default("ACTIVE") // ACTIVE | CLAIMABLE | ENDED
  criteriaType    String                     @default("TRADE_VOLUME") // TRADE_VOLUME | TRADE_COUNT | ACTIVITY_COUNT | HOLD_DAYS
  threshold       Decimal                    @default(0) @db.Decimal(78, 30)
  criteria        Json?
  startDate       DateTime                   @default(now())
  endDate         DateTime
  contractAddress String?
  lastCheckedAt   DateTime?
  /// Total allocation announced by CampaignCreated.
  rewardPool      Decimal                    @default(0) @db.Decimal(39, 0)
  /// Last applied CampaignCreated position; stale replays cannot reset dates.
  ledger          Int?
  eventIndex      Int?
  txHash          String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  qualifications  CampaignQualificationLog[]

  @@index([status])
  @@index([startDate, endDate])
  @@map("campaigns")
}

model CampaignQualificationLog {
  id          String    @id @default(cuid())
  campaignId  String
  wallet      String
  status      String    @default("QUALIFIED") // QUALIFIED | FAILED
  metricValue Decimal?
  txHash      String?
  error       String?
  qualifiedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, wallet])
  @@index([campaignId])
  @@index([wallet])
  @@index([status])
  @@map("campaign_qualification_log")
}

/// On-chain qualification and cumulative claims. No FK: event delivery may
/// precede CampaignCreated, and its eligibility must remain indexable.
model CampaignEligibility {
  id               String   @id @default(cuid())
  campaignId       String
  wallet           String
  eligible         Boolean  @default(false)
  score            Decimal  @default(0) @db.Decimal(39, 0)
  criteriaProgress Json?
  claimedAmount    Decimal  @default(0) @db.Decimal(39, 0)
  /// Claims are one-time, even when integer rounding pays zero.
  claimed          Boolean  @default(false)
  ledger           Int?
  eventIndex       Int?
  txHash           String?
  qualifiedAt      DateTime?
  updatedAt        DateTime @updatedAt

  @@unique([campaignId, wallet])
  @@index([campaignId, eligible, score(sort: Desc), wallet])
  @@index([wallet])
  @@map("campaign_eligibility")
}

/// Unique chain position makes reward claims additive exactly once.
model CampaignEvent {
  id          String   @id @default(cuid())
  campaignId  String
  type        String
  wallet      String?
  ledger      Int
  txHash      String
  eventIndex  Int
  /// Cumulative on-chain score emitted by WalletQualified.
  totalScore  Decimal? @db.Decimal(39, 0)
  payload     Json
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@unique([txHash, eventIndex])
  @@index([campaignId, ledger, eventIndex])
  @@index([campaignId, type, totalScore(sort: Desc)])
  @@map("campaign_events")
}
