// prisma/schema/activity.prisma

enum ActivityType {
  CREATOR_REGISTERED
  KEY_BOUGHT
  KEY_SOLD
  PROFILE_UPDATED
  DIVIDEND_DISTRIBUTED
  KEYS_CLAIMED
  KEY_BURNED
  KEY_TRANSFERRED
  KEY_TRANSFERRED_IN
  KEY_TRANSFERRED_OUT
  SUPPLY_CAP_SET
  TRADING_PAUSE_PROPOSED
  TRADING_PAUSE_APPROVED
  GOVERNANCE_PROPOSAL_CREATED
  TIMELOCK_LOCKUP_PROPOSED
  CIRCUIT_BREAKER_THRESHOLD_UPDATED
  GRADUATED_CURVE_CONFIGURED
  KEY_DEPRECATED
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  
  // Actor who performed the action (wallet address or user ID)
  actor       String
  
  // Optional creator associated with this activity
  creatorId   String?
  
  // Optional target of the activity (e.g., target wallet address)
  target      String?
  
  // Payload for event-specific data (e.g., price, amount, previous values)
  payload     Json
  
  createdAt   DateTime     @default(now())

  @@index([creatorId])
  @@index([actor])
  @@index([type])
}

model ActivityLog {
  id          String       @id @default(cuid())
  type        String       // buy, sell, transfer_in, transfer_out, burn, dividend
  actor       String       // wallet address
  keyId       String?
  creatorName String?
  amount      Decimal?     @default(0)
  target      String?
  txHash      String?
  payload     Json?
  timestamp   DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@unique([txHash, actor, type])
  @@index([actor])
  @@index([keyId])
  @@index([type])
  @@index([timestamp(sort: Desc)])
  @@map("activity_log")
}
