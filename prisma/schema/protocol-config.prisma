// prisma/schema/protocol-config.prisma
// Singleton protocol fee configuration.

model ProtocolConfig {
  id             String    @id @default("default")
  protocolFeeBps Int       @default(500)
  /// Timestamp when global trading was paused, if currently paused.
  pausedAt       DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  @@map("protocol_config")
}
