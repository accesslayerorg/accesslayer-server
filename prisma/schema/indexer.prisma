// prisma/schema/indexer.prisma

/// Finality status of an ingested chain event with respect to the canonical
/// ledger chain (#724).
enum IngestedEventStatus {
  /// Event has been ingested and its ledger is still considered canonical.
  CONFIRMED
  /// The event's ledger was rolled back by a reorg; its database side
  /// effects have been reversed by the reorg-guard rollback.
  REORGED
}

/// One row per ingested chain event, stamped with the ledger sequence and
/// ledger hash it was observed in (#724).
///
/// Written by the reorg-aware ingestion entry point (`ingestLedger`) so a
/// ledger rollback can identify exactly which events to mark REORGED and
/// reverse, and so re-ingestion after a rollback is auditable.
model IngestedEvent {
  id             String              @id @default(cuid())

  /// Ledger sequence the event was ingested in.
  ledgerSequence Int
  /// Hash of the ledger the event was ingested in.
  ledgerHash     String

  /// On-chain transaction hash (dedup key with eventIndex).
  txHash         String
  /// Index of the event within its transaction.
  eventIndex     Int
  /// Domain event type (e.g. KEY_BOUGHT, KEY_SOLD).
  eventType      String

  /// Wallet that performed the action, when applicable.
  actor          String?
  /// Creator/key the event applies to, when applicable.
  creatorId      String?
  /// Key quantity the event moved, as a decimal string, when applicable.
  amount         String?
  /// Per-key trade price in stroops, as a decimal string, when applicable.
  priceStroops   String?
  /// Trade timestamp carried by the event, when applicable.
  tradeAt        DateTime?

  status         IngestedEventStatus @default(CONFIRMED)
  /// Set when a reorg rolled this event back.
  reorgedAt      DateTime?

  createdAt      DateTime             @default(now())

  @@unique([txHash, eventIndex])
  @@index([ledgerSequence])
  @@index([status])
  @@index([creatorId])
  @@map("ingested_events")
}

/**
 * Dead-letter queue (DLQ) for failed indexing jobs.
 * 
 * Jobs are moved here after exhausting all retry attempts in the live indexer.
 * This provides a persistent record of failures that require manual intervention
 * or architectural fixes before reprocessing.
 */
model IndexerDLQ {
  id            String   @id @default(cuid())
  
  // The type of event or job that failed (e.g. "CREATOR_REGISTERED")
  jobType       String
  
  // Original payload or event data that caused the failure
  payload       Json
  
  // Total number of retry attempts before being moved to DLQ
  retryCount    Int      @default(0)
  
  // Human-readable reason for the final failure
  failureReason String
  
  // Optional stack trace or detailed error log
  errorDetails  String?
  
  // When the job was moved to DLQ
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([jobType])
}
